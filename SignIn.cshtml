@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Deep_Temp.styles.css" asp-append-version="true" />
    <link href="~/lib/icons/bootstrap icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/lib/datatable/datatables.min.css" rel="stylesheet" />
    <link href="~/css/dark.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body class="sign-bg">

    <div class="container-fluid sign-bg">
        <div class="row my-5 d-flex justify-content-center">

            <div class="col-5">

                <div class="login-card mt-4 ms-5">

                    <div class="login-circle">
                        <img src="~/lib/image/logo1.png" class="width" />
                    </div>

                    <form>

                        <h6>Login Account</h6>

                        <label class="form-label size mt-3">
                            Username
                        </label>

                        <div class="position-relative">

                            <i class="bi bi-person-fill position-absolute end-0 me-2 mt-1 text-secondary"></i>

                            <input type="text"
                                   class="form-control mt-2"
                                   placeholder="" />

                        </div>


                        <label class="form-label size mt-3">
                            Password
                        </label>

                        <div class="position-relative">
                            <input type="password" id="password" class="form-control mt-2 pe-5" placeholder="" />

                            <i class="bi bi-eye position-absolute top-50 end-0 translate-middle-y me-2 text-secondary" id="showPassword" style="cursor: pointer;">
                            </i>
                        </div>


                        <div class="hstack">

                            <input type="checkbox" class="form-check-input form-input-cus mt-3 " id="log" />
                            <label class="form-check-label mt-3 ms-1 me-5 notification-time text-dark " for="log">
                                Remember Me
                            </label>

                            <a class="mt-3 ms-auto size fw-normal " href="#">
                                Forget Password?
                            </a>

                        </div>

                    </form>

                    <button type="button"
                            class="btn btn-primary sign-btn p-1 mt-4 ms-4 size">
                        Signin
                    </button>
                    <div class="row">
                        <div class="col-2 border-bottom mt-3 ms-5"></div>
                        <div class="col-4">
                            <p class="notification-time text-dark d-flex justify-content-center mt-2 ">Or sign up with</p>
                        </div>
                        <div class="col-2 border-bottom mt-3"></div>

                    </div>
                    <div class="mt-3 d-flex justify-content-center me-4">
                        <div class="icon-circle shadow"><i class="bi bi-google text-secondary ms-1"></i></div>
                        <div class="icon-circle ms-2 shadow"><i class="bi bi-facebook text-secondary ms-1"></i></div>
                        <div class="icon-circle ms-2 shadow"><i class="bi bi-twitter text-secondary ms-1"></i></div>

                    </div>
                </div>
            </div>

        </div>
    </div>


    <script>
        const password = document.getElementById("password");
        const eye = document.getElementById("showPassword");

        eye.addEventListener("click", function () {

            if (password.type === "password") {

                password.type = "text";

                eye.classList.remove("bi-eye");
                eye.classList.add("bi-eye-slash");

            } else {

                password.type = "password";

                eye.classList.remove("bi-eye-slash");
                eye.classList.add("bi-eye");
            }

        });
    </script>

</body>
</html>