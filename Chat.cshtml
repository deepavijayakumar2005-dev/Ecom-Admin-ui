<div class="chat-wrapper ">

    <div class="chat-sidebar border-1 shadow rounded-3 p-3">

        <div class="chat-search">
            <i class="bi bi-person-fill"></i>

            <input type="text"
                   placeholder="People, Groups and Messages">
        </div>

        <div class="chat-tabs">
            <button class="chat-tab active">All</button>
            <button class="chat-tab">Read</button>
            <button class="chat-tab">Unread</button>
        </div>

        <div class="contact-list">

            <div class="contact active"
                 data-name="Sharuka Niji"
                 data-status="Active now"
                 data-message="This is a message from you"
                 data-reply="Peter Piper picked a peck of pickled peppers. A peck of pickled peppers Peter Piper picked."
                 data-time="Yesterday, 10 AM">
                <img src="\lib\image\prof avatar.jpg" />

                <div class="contact-info">
                    <div class="contact-name">Keerthi</div>
                    <div class="contact-message">This is a message from you</div>
                </div>

                <div class="contact-time">Just now</div>

                <span class="online-dot"></span>
            </div>


            <div class="contact"
                 data-name="Urito Nisemuno"
                 data-status="Active now"
                 data-message="Say Hi to your new friend now"
                 data-reply="Hello! Nice to meet you."
                 data-time="Yesterday, 11 PM">
                <img src="\lib\image\noti pro.jpg" />

                <div class="contact-info">
                    <div class="contact-name">Riyan</div>
                    <div class="contact-message">Say Hi to your new friend now</div>
                </div>

                <div class="contact-time">Yesterday, 11 PM</div>

                <span class="online-dot"></span>
            </div>


            <div class="contact"
                 data-name="Xiang Ledepisang"
                 data-status="Active now"
                 data-message="We can also discuss prese..."
                 data-reply="Yes, we can discuss it tomorrow."
                 data-time="Yesterday, 10 PM">
                <img src="\lib\image\prof avatar1.jpg" />

                <div class="contact-info">
                    <div class="contact-name">Deepa</div>
                    <div class="contact-message">We can also discuss prese...</div>
                </div>

                <div class="contact-time">Yesterday, 10 PM</div>

                <span class="online-dot"></span>
            </div>


            <div class="contact"
                 data-name="Abshini Thipano"
                 data-status="Active now"
                 data-message="WHAT!"
                 data-reply="WHAT! "
                 data-time="Yesterday, 10 PM">


                <img src="\lib\image\prof1.png" />

                <div class="contact-info">
                    <div class="contact-name">Banu mathi</div>
                    <div class="contact-message">WHAT!</div>
                </div>

                <div class="contact-time">Yesterday, 10 PM</div>

                <span class="online-dot"></span>
            </div>


            <div class="contact"
                 data-name="Nenko Nimitanip"
                 data-status="Active now"
                 data-message="Nenko sent an attachment"
                 data-reply="Here is the attachment you asked for."
                 data-time="Yesterday, 9 PM">
                <img src="\lib\image\prof3.jpg" />

                <div class="contact-info">
                    <div class="contact-name">Vijayakumar</div>
                    <div class="contact-message">Nenko sent an attachment</div>
                </div>

                <div class="contact-time">Yesterday, 9 PM</div>

                <span class="online-dot"></span>
            </div>


            <div class="contact"
                 data-name="Shanito Bostriglini"
                 data-status="Active now"
                 data-message="https://youtu.be/dQw4w9WgXcQ"
                 data-reply="Thanks for sharing the video!"
                 data-time="Yesterday, 1 PM">
                <img src="\lib\image\prof2.png" />

                <div class="contact-info">
                    <div class="contact-name">Gayathiri</div>
                    <div class="contact-message">https://youtu.be/dQw4w9WgXcQ</div>
                </div>

                <div class="contact-time">Yesterday, 1 PM</div>

                <span class="online-dot"></span>
            </div>

        </div>
    </div>


    <div class="chat-main">

        <div class="chat-header">

            <div class="chat-user">

                <strong id="chatName">Keerthi</strong>

                <i class="bi bi-chevron-down"></i>

                <span class="header-status">
                    <span class="status-dot"></span>
                    <span id="chatStatus">Active now</span>
                </span>

            </div>


            <div class="chat-actions">

                <button>
                    <i class="bi bi-telephone-fill"></i>
                </button>

                <button>
                    <i class="bi bi-camera-video-fill"></i>
                </button>


                <div class="btn-group">
                    <button class="" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu mt-2">
                        <li><a class="dropdown-item size" href="#"> Add to favourite</a></li>
                        <li><a class="dropdown-item size" href="#">  View profile</a></li>
                        <li><a class="dropdown-item size" href="#"> Report</a></li>
                        <li><a class="dropdown-item size" href="#">Manage Notification</a></li>
                    </ul>
                </div>
            </div>

        </div>


        <div class="messages" id="messages">

            <div class="message-row received">
                <img src="\lib\image\prof avatar.jpg" />

                <div>
                    <div class="message received-message">
                        Hi, I'm interested in the house you listed. Is it still available?
                    </div>

                    <div class="message-time">
                        Yesterday, 10 AM
                    </div>
                </div>

            </div>


            <div class="message-row sent">

                <div>

                    <div class="message sent-message">
                        Hi! Yes, the house is still available.
                    </div>

                    <div class="message-time">
                        Yesterday, 10 AM
                    </div>

                </div>

            </div>
            <div class="message-row img received">

                <img src="/lib/image/prof avatar.jpg" />

                <div>
                    <div class="message received-message house-message">

                        <div class="house-photos">
                            Could you please share the asking price?
                        </div>

                    </div>

                    <div class="message-time">
                        Yesterday, 10 AM
                    </div>
                </div>

            </div>
            <div class="message-row sent">

                <div>

                    <div class="message sent-message">
                        The asking price is ₹45 lakhs
                    </div>

                    <div class="message-time">
                        Yesterday, 10 AM
                    </div>

                </div>

            </div>
        </div>


        <div class="message-input-area">
            <input type="text" class="border-0" placeholder="Type your message..." />

            <div class="typing-text">
            </div>

            <div class="message-bottom">

                <div class="message-icons">

                    <button>
                        <i class="bi bi-emoji-smile"></i>
                    </button>

                    <button>
                        <i class="bi bi-image"></i>
                    </button>

                    <button>
                        <i class="bi bi-paperclip"></i>
                    </button>

                    <button>
                        <i class="bi bi-mic"></i>
                    </button>

                    <button>
                        <i class="bi bi-three-dots"></i>
                    </button>

                </div>


                <button class="send-btn" id="sendBtn">
                    Send
                    <i class="bi bi-send-fill"></i>
                </button>

            </div>

        </div>

    </div>

</div>

