<div class="container-fluid mb-3">
    <div class="row">
        <div class="col-md-12 d-flex justify-content-between mt-3">
            <div class="btn-group">
                <button type="button" class="btn btn-primary rounded-3 badge mb-3 me-3 ms-2 ps-3 pe-3 pt-2 pb-2 mt-2" data-bs-toggle="dropdown" aria-expanded="false">  <i class="bi bi-plus"></i> New</button>

                <ul class="dropdown-menu mt-2">
                    <li><a class="dropdown-item size text-secondary" href="#"> <i class="bi bi-file-text"></i> Document</a></li>
                    <li><a class="dropdown-item size text-secondary" href="#"> <i class="bi bi-chat-dots"></i> Message</a></li>
                    <li><a class="dropdown-item size text-secondary" href="#"> <i class="bi bi-box2"></i> Product</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item size text-secondary" href="#"> <i class="bi bi-airplane text-danger"></i> Subscription plan</a></li>
                </ul>
            </div>
            <div class="btn-group">
                <button type="button" class="btn btn-secondary rounded-3 badge mb-3 me-3 ms-2 ps-3 pe-3 pt-2 pb-2 mt-2" data-bs-toggle="dropdown" aria-expanded="false"> <i class="bi bi-file-earmark-fill"></i>  Reports <i class="bi bi-chevron-down fs-x-small"></i></button>

                <ul class="dropdown-menu mt-2 ">
                    <li><a class="dropdown-item size text-secondary" href="#"> <i class="bi bi-box2"></i> Product</a></li>
                    <li><a class="dropdown-item size text-secondary" href="#"> <i class="bi bi-people"></i> customer</a></li>
                    <li><a class="dropdown-item size text-secondary" href="#"> <i class="bi bi-cart-check"></i> Order</a></li>
                    <li><a class="dropdown-item size text-secondary" href="#"> <i class="bi bi-pie-chart-fill"></i> Console</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item size text-secondary" href="#"> <i class="bi bi-airplane text-success"></i> All Reports</a></li>
                </ul>
            </div>
        </div>
        <div class="row ">
            <div class="col-md-7 ">
                <form>
                    <div class="rounded-3 border border-1 bg-white p-2">
                        <p class="size">General Information</p>
                        <div class="row">

                            <div class="col-md-6">
                                <label class="form-label mb-0 mt-3" for="first">First Name</label>
                                <input type="text" class="form-control notification-time" placeholder="Enter you first name" id="first" required />

                            </div>
                            <div class="col-md-6">

                                <label class="form-label mb-0 mt-3">Last Name</label>
                                <input type="text" class="form-control notification-time" placeholder="Enter you Last name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label mb-0 mt-3">Birthday</label>
                                <input type="date" class="form-control notification-time" placeholder="Enter you Birth date" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label mb-0 mt-3">Gender</label>
                                <select class="notification-time form-select ps-1 pe-2 pt-0 pb-1">
                                    <option>Female</option>
                                    <option>Male</option>
                                    <option>Other</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label mb-0 mt-3">Email</label>
                                <input type="email" class="form-control notification-time" placeholder="Enter you Email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label mb-0 mt-3">Phone Number</label>
                                <input type="number" class="form-control notification-time" placeholder="+91" />
                            </div>
                            <div class="col-md-9">
                                <label class="form-label mb-0 mt-3">Address</label>
                                <input type="text" class="form-control notification-time" placeholder="Enter your Address" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label mb-0 mt-3">Number</label>
                                <input type="number" class="form-control notification-time" placeholder="no" />
                            </div>
                            <div class="col-md-4 mt-2">
                                <label class="form-label mb-0 mt-3">City</label>
                                <input type="text" class="form-control notification-time" placeholder="no" />
                            </div>
                            <div class="col-md-4 mt-2">
                                <label class="form-label mb-0 mt-3">State</label>
                                <select class="notification-time form-select ps-1 pe-2 pt-0 pb-1">
                                    <option>Tamil Nadu</option>
                                    <option>Kerala</option>
                                    <option>Karnataka</option>
                                </select>
                            </div>
                            <div class="col-md-4 mt-2">
                                <label class="form-label mb-0 mt-3">ZIP</label>
                                <input type="text" class="form-control notification-time" placeholder="ZIP" />
                            </div>
                            <div class="col-md-12 d-flex justify-content-center mt-2 mb-2 ">
                                <button type="submit" class="  btn btn-primary rounded-3 badge  me-3 ms-2 ps-3 pe-3 pt-2 pb-2 mt-2">Save All</button>
                            </div>
                        </div>
                    </div>
                </form>

            </div>

            <div class="col-md-5 ">

                <div class="rounded-3 border border-1   bg-white px-3 py-1 d-flex justify-content-center">
                    <div class="row">
                        <div class="col-md-12 d-flex justify-content-center bg-img">
                            <img src="~/lib/image/pro avartar.jpg" class="customer-img mt-5 ms-0 Setting-img" />

                        </div>
                        <div class="col-md-12  mt-5 d-flex justify-content-center">
                            <ul>
                                <li class="ms-5 size mt-2">Deepa V</li>
                                <li class="notification-time text-dark ms-3">UI/UX Designer & UI Developer</li>
                                <li class="notification-time ms-4">Tamil Nadu . Madurai</li>
                            </ul>
                        </div>
                        <div class="d-flex justify-content-center mt-3">
                            <div class="col-md-3 ">
                                <button type="button" class="btn btn-secondary size badge py-1"> <i class="bi bi-person-add"></i> Conect</button>
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn btn-primary size badge py-1">Send Message</button>
                            </div>
                        </div>
                        <div class="col-md-12 mt-4 ">
                            <div class="rounded-3 border border-1  p-3 bg-white  mb-2 shadow ">
                                <p>Select profile pic</p>
                                <div class="hstack">
                                    <img src="~/lib/image/prof avatar.jpg" class="product-img" />

                                    <label for="fileUpload" class="file-icon">
                                        <i class="bi bi-paperclip ms-2"></i>
                                    </label>

                                    <input type="file" id="fileUpload" class="d-none">
                                    <div>
                                        <p class="ms-2 size">Choose Image</p>
                                        <span class="notification-time ms-2">JPG,PNG OR GIF Maximum size of 800K</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>