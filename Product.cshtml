@section Scripts {
    <script>
        var options = {
            series: [56, 44],

            chart: {
                type: 'donut',
                height: 180
            },

            colors: ['#0357ac', '#ced4da'],

            dataLabels: {
                enabled: false
            },

            legend: {
                show: false
            },

            plotOptions: {
                pie: {
                    donut: {
                        size: '70%',
                        labels: {
                            show: true,

                            value: {
                                show: true,
                                fontSize: '14px',
                                fontWeight: 600,
                                formatter: function () {
                                    return '256.24';
                                }
                            },

                            total: {
                                show: true,
                                label: 'Total Profit',
                                fontSize: '8px',
                                formatter: function () {
                                    return '256.24';
                                }
                            }
                        }
                    }
                }
            }
        };

        var chart = new ApexCharts(
            document.querySelector("#revenueChart"),
            options
        );

        chart.render();
    </script>
}
