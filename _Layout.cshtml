<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Deep_Temp.styles.css" asp-append-version="true" />
    <link href="~/lib/icons/bootstrap icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/lib/datatable/datatables.min.css" rel="stylesheet" />
    <link href="~/css/dark.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="sidebar">

        <ul class="sidebar__nav">


            <li class="sidebar__item">
                <a class="sidebar__link " asp-controller="Test" asp-action="Dashboard">
                    <i class="bi bi-clock size small-icon ms-3"></i>
                    <span class="ms-3 fs-6">Dashboard</span>
                </a>



            </li>


            <!-- Payments -->
            <li class="sidebar__item">

                <a href="javascript:void(0);"
                   class="sidebar__link dropdown-link">
                    <div class="d-flex align-items-center gap-1">
                        <span class="dropdown-arrow">
                            <i class="bi bi-caret-down-fill"></i>
                        </span>

                        <i class="bi bi-cart small-icon"></i>

                        <span class="ms-3 fs-6">E-commerce</span>
                    </div>
                </a>
                <ul class="sidebar__submenu">

                    <li class="sidebar__submenu-item">
                        <a class="sidebar__submenu-link layout-size" asp-controller="Test" asp-action="Product" aria-expanded="false">
                            Product
                        </a>
                    </li>

                    <li class="sidebar__submenu-item">
                        <a class="sidebar__submenu-link layout-size" asp-controller="Test" asp-action="Order" aria-expanded="false">
                            Order
                        </a>
                    </li>

                    <!-- Customer dropdown -->
                    <li class="sidebar__submenu-item nested-item">

                        <a href="javascript:void(0);"
                           class="sidebar__submenu-link nested-dropdown-link">

                            <span class="layout-size">Customer</span>

                            <span class="nested-arrow">
                                <i class="bi bi-caret-down-fill"></i>
                            </span>

                        </a>

                        <ul class="sidebar__nested-submenu">

                            <li>
                                <a class="sidebar__nested-link layout-size" asp-controller="Test" asp-action="Customer">
                                    All Customer
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Test" asp-action="CustomerDetails" class="sidebar__nested-link layout-size">
                                    Customer Details
                                </a>
                            </li>

                        </ul>

                    </li>

                </ul>

            </li>
            <li class="sidebar__item">
                <a class="sidebar__link " asp-controller="Test" asp-action="Chat">
                    <i class="bi bi-chat-left small-icon ms-3"></i>
                    <span class="ms-3 fs-6">Chat</span>
                </a>
            </li>
            <li class="sidebar__item">

                <a href="javascript:void(0);"
                   class="sidebar__link dropdown-link">
                    <div class="d-flex align-items-center gap-1">
                        <span class="dropdown-arrow">
                            <i class="bi bi-caret-down-fill"></i>
                        </span>

                        <i class="bi bi-box small-icon"></i>
                        <span class="ms-3 fs-6">card</span>
                    </div>
                </a>
                <ul class="sidebar__submenu">

                    <li class="sidebar__submenu-item">
                        <a class="sidebar__submenu-link fs-6" asp-controller="Test" asp-action="CardView" aria-expanded="false">
                            card view
                        </a>
                    </li>
                </ul>
            </li>
            <li class="sidebar__item">
                <a class="sidebar__link " asp-controller="Test" asp-action="Project">
                    <i class="bi bi-file-earmark-text small-icon ms-3"></i>
                    <span class="ms-3 fs-6">Project</span>
                </a>
            </li>
            <li class="sidebar__item">
                <a class="sidebar__link " asp-controller="Test" asp-action="Board">
                    <i class="bi bi-box2 small-icon ms-3 "></i>
                    <span class="ms-3 fs-6">Board</span>
                </a>
            </li>
            <li class="sidebar__item">
                <a class="sidebar__link " asp-controller="Test" asp-action="Calender">
                    <i class="bi bi-calendar small-icon ms-3"></i>
                    <span class="ms-3 fs-6">Calender</span>
                </a>
            </li>
            <li class="sidebar__item">
                <a class="sidebar__link " asp-controller="Test" asp-action="Setting">
                    <i class="bi bi-gear small-icon ms-3"></i>
                    <span class="ms-3 fs-6">Setting</span>
                </a>
            </li>

            <li class="sidebar__item">
                <a class="sidebar__link " asp-controller="Test" asp-action="SignIn">
                    <i class="bi bi-box-arrow-in-right small-icon ms-3"></i>
                    <span class="ms-3 fs-6">Signin</span>
                </a>
            </li>

        </ul>







    </div>
    <header>

        <div class="navbar">

            <div class="navbar-logo">
                <img src="~/lib/image/logo fi.png" class="navbar-logo-img mb-3 ms-2" />
            </div>

            <div class="navbar-left">
                <button type="button" id="sidebarToggle" class="sidebar-toggle mb-3">
                    <i class="bi bi-list"></i>
                </button>

            </div>
            <div class="search-box mb-2">
                <input type="checkbox" id="searchToggle" class="search-toggle">

                <input type="text" class="search-input mb-4 ms-3" placeholder="Search..." />

                <label for="searchToggle" class="search-icon ms-3 mb-4">
                    <i class="bi bi-search fs-6"></i>
                </label>
            </div>





            <div class="theme-toggle ms-auto mb-4">
                <button type="button" id="themeToggle" class="theme-btn mt-1">
                    <i class="bi bi-sun-fill" id="themeIcon"></i>
                </button>

                <div class="btn-group mb-1">
                    <button type="button" class="theme-btn" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-bell theme-btn "></i>
                    </button>
                    <ul class="dropdown-menu mt-4 modal-dialog-end">
                        <li>
                            <a class="dropdown-item size text-secondary" href="#">
                                <div class="notification-item">

                                    <div class="notification-profile">
                                        <img src="~/lib/image/noti pro.jpg"
                                             class="notification-profile-img" />

                                        <span class="notification-status"></span>
                                    </div>

                                    <div class="notification-text">

                                        <div class="notification-message">
                                            <strong>Leo Antony</strong>
                                            <span class="notification-time">project-Champer App</span>
                                        </div>

                                        <div class="notification-time">
                                            5 min ago
                                        </div>

                                    </div>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item size text-secondary" href="#">
                                <div class="notification-item">

                                    <div class="notification-profile">
                                        <img src="~/lib/image/noti pro.jpg"
                                             class="notification-profile-img" />

                                        <span class="notification-status"></span>
                                    </div>

                                    <div class="notification-text">

                                        <div class="notification-message">
                                            <strong>Leo Antony</strong>
                                            <span class="notification-time">project-Champer App</span>
                                        </div>

                                        <div class="notification-time">
                                            5 min ago
                                        </div>

                                    </div>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item size text-secondary" href="#">
                                <div class="notification-item">

                                    <div class="notification-profile">
                                        <img src="~/lib/image/noti pro.jpg"
                                             class="notification-profile-img" />

                                        <span class="notification-status"></span>
                                    </div>

                                    <div class="notification-text">

                                        <div class="notification-message">
                                            <strong>Leo Antony</strong>
                                            <span class="notification-time">project-Champer App</span>
                                        </div>

                                        <div class="notification-time">
                                            5 min ago
                                        </div>

                                    </div>
                                </div>
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item size text-primary size ms-4" href="#">  View All Message</a></li>
                    </ul>


                    <div class="btn-group ms-2">

                        <button type="button"
                                class="profile-btn"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="~/lib/image/pro avartar.jpg" class="prof-imgs" />

                        </button>
                        <ul class="dropdown-menu mt-4 modal-dialog-ends">
                            <li>
                                <a class="dropdown-item size text-secondary" href="#">
                                    <div class="profile-modal-container">
                                        <img src="~/lib/image/pro avartar.jpg" class="profile-modal-img" />


                                        <span class="profile-modal-name">
                                            Deepa V
                                        </span>

                                        <div class="profile-add-account  border border-1 rounded-3  ps-3 pe-3">
                                            <i class="bi bi-person-plus"></i>
                                            Add another account
                                        </div>

                                    </div>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item size text-secondary" href="#">
                                    <p>
                                        <i class="bi bi-person"></i>
                                        Profile
                                    </p>

                                    <p>
                                        <i class="bi bi-stopwatch"></i>
                                        Dashboard
                                    </p>

                                    <p>
                                        <i class="bi bi-bag"></i>
                                        Post & Activity
                                    </p>

                                    <p>
                                        <i class="bi bi-gear"></i>
                                        Setting & Privacy
                                    </p>

                                    <p class="mb-0">
                                        <i class="bi bi-question-circle"></i>
                                        Help Center
                                    </p>

                                </a>
                            </li>

                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item size text-danger" asp-controller="Test" asp-action="SignIn">

                                    <button type="button"
                                            class="profile-signout-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#pro">

                                        <i class="bi bi-box-arrow-right"></i>
                                        Sign Out
                                    </button>

                                </a>
                            </li>

                        </ul>
                    </div>
                </div>

            </div>
        </div>


    </header>
    <div class="main-content ">

        @RenderBody()
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/apexcharts/apexcharts.js"></script>
    <script src="~/lib/datatable/datatables.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)



</body>
</html>






