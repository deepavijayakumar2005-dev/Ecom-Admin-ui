                    show: false
                },
                axisBorder: {
                    show: false
                },
                axisTicks: {
                    show: false
                }
            },

            yaxis: {
                show: false
            },

            grid: {
                show: false,
                padding: {
                    top: -10,
                    bottom: -5,
                    left: 0,
                    right: 0
                }
