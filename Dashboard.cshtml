                    toolbar: {
                        show: false
                    },
                    sparkline: {
                        enabled: true
                    }
                },

                stroke: {
                    curve: "smooth",
                    width: 2
                },

                colors: ["#2878e8"],

                fill: {
                    type: "gradient",
                    gradient: {
                        opacityFrom: 0.25,
                        opacityTo: 0.02
