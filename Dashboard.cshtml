                sparkline: {
                    enabled: true
                }
            },

            plotOptions: {
                radialBar: {
                    startAngle: -90,
                    endAngle: 90,

                    hollow: {
                        size: "60%"
                    },

                    track: {
                        background: "#E9EDF5",
                        strokeWidth: "100%"
                    },

                    dataLabels: {
                        name: {
                            show: true,
                            offsetY: 25,
                            fontSize: "13px",
                            color: "#777"
                        },

                        value: {
                            show: true,
                            offsetY: -10,
                            fontSize: "28px",
                            fontWeight: 600,
                            color: "#333",
                            formatter: function (value) {
                                return value + "%";
                            }
                        }
                    }
                }
            },

            colors: ["#4964C7"],

            labels: ["Performance"],

            stroke: {
                lineCap: "round"
            }
        };

        var chart = new ApexCharts(
            document.querySelector("#gaugeChart"),
            options
        );

        chart.render();

