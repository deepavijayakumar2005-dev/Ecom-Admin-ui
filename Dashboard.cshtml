                },

                dataLabels: {
                    enabled: false
                },

                tooltip: {
                    enabled: false
                },

                xaxis: {
                    show: false
                },

                yaxis: {
                    show: false
                },

                grid: {
                    show: false
                }
            };

            var totalOrderChart =
                new ApexCharts(
                    document.querySelector("#totalOrderChart"),
                    totalOrderOptions
                );

            totalOrderChart.render();


            // =========================
            // MARKET SHARE
            // =========================

            var marketShareOptions = {

                series: [45, 30, 25],

                chart: {
                    type: "donut",
