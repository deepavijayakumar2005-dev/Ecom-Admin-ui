            dataLabels: {
                enabled: false
            },

            legend: {
                show: true,
                position: "bottom",
                horizontalAlign: "left",
                fontSize: "11px",
                markers: {
                    width: 8,
                    height: 8,
                    radius: 50
                },
                itemMargin: {
                    horizontal: 8,
                    vertical: 0
                }
            },

            tooltip: {
                y: {
                    formatter: function (value) {
                        return value + "MB";
                    }
                }
            }
        };

