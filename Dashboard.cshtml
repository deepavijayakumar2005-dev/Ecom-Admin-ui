                }
            },

            stroke: {
                lineCap: "round"
            }
        };

        var chart = new ApexCharts(
            document.querySelector("#storageRadial"),
            options
        );

        chart.render();



        // MIXEDCHART

            var options = {
            series: [
                {
                    name: "Orders",
