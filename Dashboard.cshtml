<script>
            document.addEventListener("DOMContentLoaded", function () {

            // =========================
            // WEEKLY SALES
            // =========================

            var weeklySalesOptions = {
                series: [{
                    name: "Sales",
                    data: [20, 35, 28, 45, 30, 25, 38]
                }],

                chart: {
                    type: "bar",
                    height: 75,
                    toolbar: {
                        show: false
                    },
                    sparkline: {
                        enabled: true
                    }
                },

                plotOptions: {
                    bar: {
                        columnWidth: "25%",
                        borderRadius: 2
                    }
                },

                colors: ["#2878e8"],

                tooltip: {
                    enabled: false
                },

                dataLabels: {
                    enabled: false
                },

                yaxis: {
                    show: false
                },

                xaxis: {
                    show: false
                },

                grid: {
                    show: false
                }
            };

            var weeklySalesChart =
                new ApexCharts(
                    document.querySelector("#weeklySalesChart"),
                    weeklySalesOptions
                );

            weeklySalesChart.render();


            // =========================
            // TOTAL ORDER
            // =========================

            var totalOrderOptions = {
                series: [{
                    name: "Orders",
                    data: [20, 22, 25, 27, 32, 42, 48, 58]
