            };

            var marketShareChart =
                new ApexCharts(
                    document.querySelector("#marketShareChart"),
                    marketShareOptions
                );

            marketShareChart.render();

    // STORAGECHART

              var options = {
            series: [
                {
                    name: "Regular",
                    data: [895]
                },
                {
                    name: "System",
                    data: [379]
                },
                {
                    name: "Shared",
                    data: [192]
                },
                {
                    name: "Free",
                    data: [576]
                }
            ],

