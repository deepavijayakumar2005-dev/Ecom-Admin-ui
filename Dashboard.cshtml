                    show: false
                },

                axisTicks: {
                    show: false
                },

                labels: {
                    style: {
                        colors: "#9CA3AF",
                        fontSize: "11px"
                    }
                }
            },

            yaxis: {
                labels: {
                    style: {
                        colors: "#9CA3AF",
                        fontSize: "11px"
                    }
                }
            },

            grid: {
                borderColor: "#E5E7EB",
                strokeDashArray: 4
            },

            markers: {
                size: 4,
                colors: ["#fff"],
                strokeColors: "#4964C7",
                strokeWidth: 2
            },

            legend: {
                position: "top",
                horizontalAlign: "right",
                fontSize: "12px"
            },

